# Copia este archivo a .env y completa los valores antes de levantar el stack:
#   cp .env.example .env   (Linux/macOS)
#   Copy-Item .env.example .env   (Windows PowerShell)

DATABASE_URL=postgresql://postgres:postgres@db:5432/document_analyzer?schema=public
REDIS_URL=redis://redis:6379
PORT=3000
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
RESEND_API_KEY=
RESEND_FROM=Document Analyzer <onboarding@resend.dev>
FRONTEND_URL=http://localhost:4200
STORAGE_PATH=./storage
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini

# Poner NODE_ENV=production solo al desplegar detrás de HTTPS/TLS:
# activa cookies Secure en el backend. En local (http://localhost:4200) debe quedar sin valor.
# NODE_ENV=production